
:root {
    --forest: #203d32;
    --forest-dark: #172d25;
    --cream: #f5f2eb;
    --paper: #fbfaf7;
    --gold: #c6a77a;
    --text: #26342d;
    --muted: #727b72;
    --line: #deded4;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    margin: 0;
    background: var(--paper);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
}

a {
    color: inherit;
}

.site-header {
    min-height: 86px;
    padding: 20px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    background: var(--paper);
}

.logo {
    color: var(--forest);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 29px;
    font-weight: bold;
    letter-spacing: -1.5px;
    text-decoration: none;
}

.logo span {
    color: #a18152;
}

.site-header nav {
    display: flex;
    align-items: center;
    gap: 32px;
}

.site-header nav a,
.header-cta {
    font-size: 13px;
    text-decoration: none;
}

.site-header nav a {
    color: #555e55;
}

.site-header nav a:hover,
.site-footer a:hover {
    color: var(--gold);
}

.header-cta {
    padding: 11px 18px;
    border: 1px solid var(--forest);
    border-radius: 2px;
}

.hero {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--forest-dark);
    color: white;
}

.hero-content {
    position: relative;
    z-index: 2;
    width: 58%;
    padding: 90px 0 100px 9%;
}

.eyebrow {
    margin: 0 0 22px;
    color: #9d835e;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2.5px;
    line-height: 1.8;
}

.hero .eyebrow {
    color: #d4bc96;
}

.hero h1,
.intro h2,
.section-heading h2,
.approach h2,
.contact h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: normal;
    letter-spacing: -1.5px;
    line-height: 1.12;
}

.hero h1 {
    font-size: clamp(44px, 5.4vw, 76px);
}

h1 em,
h2 em {
    color: var(--gold);
    font-weight: normal;
}

.hero-description {
    max-width: 410px;
    margin: 25px 0 30px;
    color: #d2d9d2;
    font-size: 15px;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 15px 21px;
    font-size: 12px;
    font-weight: bold;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
}

.button-light {
    background: var(--cream);
    color: var(--forest);
}

.button-light:hover {
    background: white;
}

.hero-note {
    margin-top: 23px;
    color: #c0c9c0;
    font-size: 11px;
}

.hero-image {
    position: absolute;
    inset: 0 0 0 54%;
    background-image:
        linear-gradient(90deg, var(--forest-dark), transparent 32%),
        url("https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1500&q=85");
    background-size: cover;
    background-position: center;
    opacity: 0.82;
}

.hero-caption {
    position: absolute;
    right: 7%;
    bottom: 25px;
    left: 9%;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    color: #e0e5dc;
    font-size: 9px;
    letter-spacing: 1.5px;
}

.intro {
    max-width: 860px;
    margin: 0 auto;
    padding: 105px 30px 110px;
    text-align: center;
}

.intro h2,
.approach h2,
.contact h2 {
    font-size: clamp(34px, 4vw, 51px);
}

.intro h2 em,
.approach h2 em,
.contact h2 em {
    color: #9b805b;
}

.intro-text {
    max-width: 560px;
    margin: 25px auto 0;
    color: var(--muted);
    font-size: 14px;
}

.services {
    padding: 80px 8%;
    background: var(--cream);
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 38px;
}

.section-heading .eyebrow {
    margin-bottom: 12px;
}

.section-heading h2 {
    font-size: clamp(34px, 4vw, 47px);
}

.section-heading > p {
    max-width: 270px;
    color: var(--muted);
    font-size: 13px;
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 300px;
    padding: 27px;
    border: 1px solid var(--line);
    background: var(--paper);
}

.service-number {
    color: #8b8d80;
    font-size: 9px;
    letter-spacing: 1.5px;
}

.service-icon {
    margin: 22px 0 8px;
    color: #a18152;
    font-family: Georgia, serif;
    font-size: 32px;
}

.service-card h3 {
    margin: 0 0 8px;
    font-family: Georgia, serif;
    font-size: 23px;
    font-weight: normal;
}

.service-card p {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 12px;
}

.service-card a,
.text-link {
    margin-top: auto;
    color: var(--forest);
    font-size: 11px;
    font-weight: bold;
    text-decoration: none;
}

.service-card a:hover,
.text-link:hover {
    color: #9b805b;
}

.approach {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 460px;
    background: var(--forest);
    color: white;
}

.approach-image {
    min-height: 380px;
    background-image: url("https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=85");
    background-size: cover;
    background-position: center;
}

.approach-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 65px 11%;
}

.approach-content .eyebrow {
    color: #d4bc96;
}

.approach h2 {
    font-size: clamp(32px, 3.6vw, 47px);
}

.approach h2 em {
    color: #d1b48a;
}

.approach-content > p:not(.eyebrow) {
    margin: 22px 0 28px;
    color: #d0d8d0;
    font-size: 13px;
}

.text-link {
    color: white;
    border-bottom: 1px solid #a99573;
    padding-bottom: 7px;
}

.contact {
    padding: 100px 25px;
    text-align: center;
}

.contact h2 {
    max-width: 730px;
    margin: 0 auto;
}

.contact > p:not(.eyebrow) {
    margin: 20px 0 25px;
    color: var(--muted);
    font-size: 13px;
}

.button-dark {
    background: var(--forest);
    color: white;
}

.button-dark:hover {
    background: var(--forest-dark);
}

.contact .contact-note {
    margin-top: 24px;
    font-size: 10px;
}

.site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 35px 7%;
    background: var(--forest-dark);
    color: #e8e9df;
}

.logo-footer {
    color: white;
    font-size: 25px;
}

.site-footer > p,
.site-footer > a:not(.logo) {
    font-size: 11px;
}

.site-footer > a:not(.logo) {
    text-decoration: none;
}

.site-footer small {
    width: 100%;
    padding-top: 18px;
    border-top: 1px solid #43554a;
    color: #c0c9c0;
    font-size: 10px;
}

@media (max-width: 800px) {
    .site-header {
        padding: 18px 5%;
        gap: 15px;
    }

    .site-header nav {
        gap: 15px;
    }

    .hero {
        min-height: 590px;
    }

    .hero-content {
        width: 75%;
        padding-left: 7%;
    }

    .hero-image {
        left: 35%;
        opacity: 0.45;
    }

    .services {
        padding: 65px 5%;
    }

    .service-grid {
        gap: 12px;
    }

    .service-card {
        padding: 18px;
    }

    .approach-content {
        padding: 45px 8%;
    }
}

@media (max-width: 600px) {
    .site-header {
        display: grid;
        grid-template-columns: 1fr auto;
    }

    .site-header nav {
        grid-column: 1 / -1;
        grid-row: 2;
        justify-content: space-between;
        gap: 12px;
    }

    .site-header nav a {
        font-size: 12px;
    }

    .header-cta {
        padding: 9px 11px;
        font-size: 11px;
    }

    .hero {
        min-height: 610px;
        align-items: flex-end;
    }

    .hero-content {
        width: 100%;
        padding: 100px 25px 85px;
    }

    .hero-image {
        inset: 0;
        background-image:
            linear-gradient(0deg, var(--forest-dark) 12%, rgba(23,45,37,0.65) 65%, rgba(23,45,37,0.2)),
            url("https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1000&q=85");
        opacity: 0.9;
    }

    .hero h1 {
        font-size: 45px;
    }

    .hero-caption {
        right: 25px;
        left: 25px;
        font-size: 8px;
    }

    .intro {
        padding: 75px 25px;
    }

    .section-heading {
        display: block;
    }

    .section-heading > p {
        margin-top: 16px;
    }

    .service-grid {
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .service-card {
        min-height: 260px;
        padding: 25px;
    }

    .approach {
        grid-template-columns: 1fr;
    }

    .approach-image {
        min-height: 300px;
    }

    .approach-content {
        padding: 55px 25px 65px;
    }

    .contact {
        padding: 75px 22px;
    }

    .site-footer {
        flex-direction: column;
        align-items: flex-start;
        padding: 30px 25px;
        gap: 12px;
    }
}

/* Contact form */

.contact-form {
    width: 100%;
    max-width: 620px;
    margin: 35px auto 0;
    padding: 28px;
    text-align: left;
    background: var(--bg-soft, #191a17);
    border: 1px solid var(--border, rgba(222, 207, 174, 0.17));
}

.form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
}

.form-field label {
    color: var(--text, #f2efe7);
    font-size: 13px;
    font-weight: 600;
}

.form-field input,
.form-field select,
.form-field textarea {
    width: 100%;
    padding: 13px 14px;
    border: 1px solid var(--border, #44443b);
    border-radius: 0;
    background: #111210;
    color: var(--text, #f2efe7);
    font: inherit;
    font-size: 14px;
}

.form-field input,
.form-field select {
    min-height: 48px;
}

.form-field textarea {
    min-height: 125px;
    resize: vertical;
}

.form-field input::placeholder,
.form-field textarea::placeholder {
    color: #929187;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
    outline: 1px solid var(--gold, #c9aa75);
    border-color: var(--gold, #c9aa75);
}

.submit-button {
    width: 100%;
    cursor: pointer;
    font: inherit;
}

@media (max-width: 550px) {
    .contact-form {
        padding: 20px 16px;
    }
}

/* Service cards with photography */

.service-card {
    padding: 0;
    overflow: hidden;
}

.service-image {
    position: relative;
    height: 240px;
    overflow: hidden;
    background: #191a17;
}

.service-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.service-card:hover .service-image img {
    transform: scale(1.05);
}

.service-image .service-number {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 8px 11px;
    background: rgba(17, 18, 16, 0.88);
    border: 1px solid rgba(222, 207, 174, 0.25);
    color: #e0c18d;
    font-size: 11px;
    letter-spacing: 1px;
}

.service-content {
    padding: 25px;
}

.service-content h3 {
    margin-top: 0;
}

.service-content p {
    line-height: 1.7;
}

.service-content a {
    display: inline-block;
    margin-top: 12px;
}

@media (max-width: 600px) {
    .service-image {
        height: 220px;
    }

    .service-content {
        padding: 20px;
    }
}

/* BrightHome contact form color upgrade */

.contact-form {
    background: #222019;
    border: 1px solid rgba(210, 178, 119, 0.4);
    padding: 32px;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18);
}

.form-field input,
.form-field select,
.form-field textarea {
    background: #171713;
    border: 1px solid #514735;
    color: #f5f0e5;
    transition: border-color 0.25s ease,
                box-shadow 0.25s ease;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
    outline: none;
    border-color: #d4b47a;
    box-shadow: 0 0 0 3px rgba(212, 180, 122, 0.12);
}

.form-field label {
    color: #e5d5b6;
}

.submit-button {
    background: #d4b47a;
    color: #171713;
    border: 1px solid #d4b47a;
    transition: background 0.25s ease,
                transform 0.25s ease;
}

.submit-button:hover {
    background: #e4c995;
    transform: translateY(-2px);
}

@media (max-width: 550px) {
    .contact-form {
        padding: 22px 16px;
    }
}
